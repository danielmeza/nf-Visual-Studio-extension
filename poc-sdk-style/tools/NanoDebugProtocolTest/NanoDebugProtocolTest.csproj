<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Layer A test harness (RESULTS.md). Headless, no Visual Studio: it drives the
    SHARED nf-debugger wire-protocol client (nanoFramework.Tools.DebugLibrary) to
    connect to a nanoCLR device, deploy the SDK-built .pe, run it, and observe
    execution + a breakpoint round-trip.

    Builds anywhere (net8.0). It only *runs* end-to-end against a nanoCLR device —
    the `nanoclr` virtual device is Windows-only — so the run stage executes on the
    Windows CI agent (see azure-pipelines stage in the repo root).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>nanoFramework.Poc.DebugProtocolTest</RootNamespace>
    <AssemblyName>nano-debug-protocol-test</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same wire-protocol client both the AD7 and future Concord bindings use. -->
    <PackageReference Include="nanoFramework.Tools.Debugger.Net" Version="2.5.10" />
  </ItemGroup>

</Project>
