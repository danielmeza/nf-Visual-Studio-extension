<configuration>
  <packageSources>
    <!-- Standard tooling: restore CoreLibrary straight from nuget.org.
         No local feed, no POC-built packages - this is the control case. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
